# Copy to .env to override defaults.

STACK_NAME=otel
STACK_NETWORK=otel-net

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_PLUGINS_PREINSTALL=grafana-pyroscope-app,grafana-llm-app

PROMETHEUS_CPUS=1
PROMETHEUS_MEMORY=1G
PROMETHEUS_USER=0:0
LOKI_CPUS=1
LOKI_MEMORY=1G
LOKI_USER=0:0
LOKI_READY_TIMEOUT=120
TEMPO_CPUS=1
TEMPO_MEMORY=1G
TEMPO_USER=0:0
TEMPO_READY_TIMEOUT=30
PYROSCOPE_CPUS=1
PYROSCOPE_MEMORY=1G
PYROSCOPE_USER=0:0
PYROSCOPE_READY_TIMEOUT=120
GRAFANA_CPUS=1
GRAFANA_MEMORY=1G
OTELCOL_CPUS=1
OTELCOL_MEMORY=1G
