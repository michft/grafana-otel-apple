# Versions copied from the upstream docker-otel-lgtm Dockerfile on 2026-05-26.

GRAFANA_VERSION=v13.0.1
PROMETHEUS_VERSION=v3.11.3
TEMPO_VERSION=v2.10.5
LOKI_VERSION=v3.7.2
PYROSCOPE_VERSION=v2.0.2
OPENTELEMETRY_COLLECTOR_VERSION=v0.152.0
OBI_VERSION=v0.9.0

# Current standalone OCI images usually use tag values without the leading "v".
# Prometheus keeps the upstream "v" in its image tag.
GRAFANA_IMAGE_TAG=13.0.1
PROMETHEUS_IMAGE_TAG=v3.11.3
TEMPO_IMAGE_TAG=2.10.5
LOKI_IMAGE_TAG=3.7.2
PYROSCOPE_IMAGE_TAG=2.0.2
OPENTELEMETRY_COLLECTOR_IMAGE_TAG=0.152.0

GRAFANA_IMAGE=${GRAFANA_IMAGE:-docker.io/grafana/grafana:${GRAFANA_IMAGE_TAG}}
PROMETHEUS_IMAGE=${PROMETHEUS_IMAGE:-docker.io/prom/prometheus:${PROMETHEUS_IMAGE_TAG}}
TEMPO_IMAGE=${TEMPO_IMAGE:-docker.io/grafana/tempo:${TEMPO_IMAGE_TAG}}
LOKI_IMAGE=${LOKI_IMAGE:-docker.io/grafana/loki:${LOKI_IMAGE_TAG}}
PYROSCOPE_IMAGE=${PYROSCOPE_IMAGE:-docker.io/grafana/pyroscope:${PYROSCOPE_IMAGE_TAG}}
OTELCOL_IMAGE=${OTELCOL_IMAGE:-docker.io/otel/opentelemetry-collector-contrib:${OPENTELEMETRY_COLLECTOR_IMAGE_TAG}}

